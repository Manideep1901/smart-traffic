<nodes>
    <!-- 6 Signalized Intersections (2x3 Grid) -->
    <node id="J1" x="0"   y="300"  type="traffic_light"/>
    <node id="J2" x="300" y="300"  type="traffic_light"/>
    <node id="J3" x="600" y="300"  type="traffic_light"/>
    <node id="J4" x="0"   y="0"    type="traffic_light"/>
    <node id="J5" x="300" y="0"    type="traffic_light"/>
    <node id="J6" x="600" y="0"    type="traffic_light"/>

    <!-- Boundary Entry / Exit Nodes -->
    <!-- North Perimeter -->
    <node id="N1" x="0"   y="600"  type="priority"/>
    <node id="N2" x="300" y="600"  type="priority"/>
    <node id="N3" x="600" y="600"  type="priority"/>

    <!-- South Perimeter -->
    <node id="S1" x="0"   y="-300" type="priority"/>
    <node id="S2" x="300" y="-300" type="priority"/>
    <node id="S3" x="600" y="-300" type="priority"/>

    <!-- West Perimeter -->
    <node id="W1" x="-300" y="300" type="priority"/>
    <node id="W2" x="-300" y="0"   type="priority"/>

    <!-- East Perimeter -->
    <node id="E1" x="900"  y="300" type="priority"/>
    <node id="E2" x="900"  y="0"   type="priority"/>
</nodes>
