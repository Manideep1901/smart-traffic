<routes>
    <!-- ======================================================== -->
    <!-- REALISTIC VEHICLE TYPE DEFINITIONS                       -->
    <!-- ======================================================== -->
    <!-- Passenger Cars: Sedans, Hatchbacks, Wagons & SUVs -->
    <vType id="car_silver" vClass="passenger" guiShape="passenger/sedan" length="4.7" width="1.80"
           accel="2.6" decel="4.5" emergencyDecel="6.0" sigma="0.5" maxSpeed="20.0" minGap="2.5"
           color="0.82,0.84,0.88"/>
    
    <vType id="car_red" vClass="passenger" guiShape="passenger/hatchback" length="4.2" width="1.75"
           accel="2.8" decel="4.5" emergencyDecel="6.0" sigma="0.5" maxSpeed="21.0" minGap="2.2"
           color="0.85,0.15,0.18"/>

    <vType id="car_blue" vClass="passenger" guiShape="passenger/sedan" length="4.8" width="1.82"
           accel="2.7" decel="4.5" emergencyDecel="6.0" sigma="0.5" maxSpeed="20.0" minGap="2.5"
           color="0.12,0.35,0.78"/>

    <vType id="car_suv" vClass="passenger" guiShape="passenger/wagon" length="4.9" width="1.95"
           accel="2.5" decel="4.2" emergencyDecel="5.8" sigma="0.5" maxSpeed="19.0" minGap="2.5"
           color="0.22,0.24,0.28"/>

    <vType id="car_white" vClass="passenger" guiShape="passenger/sedan" length="4.5" width="1.80"
           accel="2.6" decel="4.5" emergencyDecel="6.0" sigma="0.5" maxSpeed="20.0" minGap="2.5"
           color="0.96,0.96,0.96"/>

    <!-- Passenger & Commercial Vans -->
    <vType id="van_white" vClass="passenger" guiShape="passenger/van" length="5.2" width="1.95"
           accel="2.2" decel="4.0" emergencyDecel="5.5" sigma="0.5" maxSpeed="18.0" minGap="2.5"
           color="0.92,0.92,0.95"/>

    <!-- Public Transit Buses -->
    <vType id="city_bus" vClass="bus" guiShape="bus" length="12.0" width="2.55"
           accel="1.8" decel="3.5" emergencyDecel="5.0" sigma="0.4" maxSpeed="15.0" minGap="3.0"
           color="0.95,0.72,0.10"/>

    <vType id="coach_bus" vClass="bus" guiShape="bus/coach" length="13.5" width="2.55"
           accel="1.7" decel="3.5" emergencyDecel="5.0" sigma="0.4" maxSpeed="16.0" minGap="3.5"
           color="0.15,0.60,0.68"/>

    <!-- Logistics & Freight Trucks -->
    <vType id="delivery_truck" vClass="truck" guiShape="truck" length="7.5" width="2.35"
           accel="2.0" decel="3.8" emergencyDecel="5.0" sigma="0.5" maxSpeed="16.0" minGap="3.0"
           color="0.92,0.48,0.12"/>

    <vType id="heavy_truck" vClass="truck" guiShape="truck/semitrailer" length="15.5" width="2.55"
           accel="1.3" decel="3.0" emergencyDecel="4.5" sigma="0.4" maxSpeed="13.5" minGap="4.0"
           color="0.45,0.48,0.52"/>

    <!-- Two-Wheelers -->
    <vType id="motorcycle" vClass="motorcycle" guiShape="motorcycle" length="2.2" width="0.90"
           accel="3.5" decel="5.0" emergencyDecel="6.5" sigma="0.6" maxSpeed="22.0" minGap="1.5"
           color="0.80,0.18,0.18"/>

    <!-- Legacy aliases for backward compatibility -->
    <vType id="car" vClass="passenger" guiShape="passenger/sedan" length="4.6" width="1.80"
           accel="2.6" decel="4.5" emergencyDecel="6.0" sigma="0.5" maxSpeed="20.0" minGap="2.5"
           color="0.85,0.85,0.88"/>
    <vType id="bus" vClass="bus" guiShape="bus" length="12.0" width="2.55"
           accel="1.8" decel="3.5" emergencyDecel="5.0" sigma="0.4" maxSpeed="15.0" minGap="3.0"
           color="0.95,0.72,0.10"/>
    <vType id="truck" vClass="truck" guiShape="truck" length="7.5" width="2.35"
           accel="2.0" decel="3.8" emergencyDecel="5.0" sigma="0.5" maxSpeed="16.0" minGap="3.0"
           color="0.92,0.48,0.12"/>

    <!-- ======================================================== -->
    <!-- ROUTE DEFINITIONS ACROSS MULTI-JUNCTION NETWORK           -->
    <!-- ======================================================== -->

    <!-- Central Highway Corridors (Multi-Junction J1, J2, J3) -->
    <route id="r_W1_E1" edges="W1toJ1 J1toJ2 J2toJ3 J3toE1"/>
    <route id="r_E1_W1" edges="E1toJ3 J3toJ2 J2toJ1 J1toW1"/>

    <!-- Right Highway Corridors (Multi-Junction J3, J6) -->
    <route id="r_N3_S3" edges="N3toJ3 J3toJ6 J6toS3"/>
    <route id="r_S3_N3" edges="S3toJ6 J6toJ3 J3toN3"/>

    <!-- Local Corridor (Multi-Junction J4, J5, J6) -->
    <route id="r_W2_E2" edges="W2toJ4 J4toJ5 J5toJ6 J6toE2"/>
    <route id="r_E2_W2" edges="E2toJ6 J6toJ5 J5toJ4 J4toW2"/>

    <!-- Diagonal Corridor from N1 (Multi-Junction J1, J2, J3) -->
    <route id="r_N1_E1" edges="N1toJ1 J1toJ2 J2toJ3 J3toE1"/>
    <route id="r_N1_S1" edges="N1toJ1 J1toJ4 J4toS1"/>

    <!-- Vertical Corridors -->
    <route id="r_N2_S2" edges="N2toJ2 J2toJ5 J5toS2"/>
    <route id="r_S2_N2" edges="S2toJ5 J5toJ2 J2toN2"/>
    <route id="r_S1_N1" edges="S1toJ4 J4toJ1 J1toN1"/>

    <!-- Multi-Junction Cross Routes -->
    <route id="r_W1_S1" edges="W1toJ1 J1toJ4 J4toS1"/>
    <route id="r_E1_S1" edges="E1toJ3 J3toJ2 J2toJ1 J1toJ4 J4toS1"/>
    <route id="r_N2_E2" edges="N2toJ2 J2toJ3 J3toJ6 J6toE2"/>
    <route id="r_W2_N2" edges="W2toJ4 J4toJ5 J5toJ2 J2toN2"/>
    <route id="r_S2_N3" edges="S2toJ5 J5toJ6 J6toJ3 J3toN3"/>
    <route id="r_N3_W1" edges="N3toJ3 J3toJ2 J2toJ1 J1toW1"/>
    <route id="r_W1_S2" edges="W1toJ1 J1toJ2 J2toJ5 J5toS2"/>

    <!-- ======================================================== -->
    <!-- VEHICLE FLOWS (BALANCED MULTI-CLASS DISTRIBUTION)         -->
    <!-- ~75% Cars/Sedans/SUVs, ~10% Vans, ~8% Buses, ~5% Trucks, ~2% Moto -->
    <!-- ======================================================== -->
    <!-- Highway Primary Flows -->
    <flow id="flow_hwy_W1_E1_sedan" type="car_silver" route="r_W1_E1" begin="0" end="1000" vehsPerHour="130"/>
    <flow id="flow_hwy_W1_E1_van" type="van_white" route="r_W1_E1" begin="0" end="1000" vehsPerHour="40"/>
    <flow id="flow_hwy_W1_E1_suv" type="car_suv" route="r_W1_E1" begin="0" end="1000" vehsPerHour="90"/>
    <flow id="flow_hwy_W1_E1_red" type="car_red" route="r_W1_E1" begin="0" end="1000" vehsPerHour="70"/>

    <flow id="flow_hwy_E1_W1_blue" type="car_blue" route="r_E1_W1" begin="0" end="1000" vehsPerHour="130"/>
    <flow id="flow_hwy_E1_W1_white" type="car_white" route="r_E1_W1" begin="0" end="1000" vehsPerHour="100"/>
    <flow id="flow_hwy_E1_W1_van" type="van_white" route="r_E1_W1" begin="0" end="1000" vehsPerHour="30"/>

    <flow id="flow_hwy_N3_S3_sedan" type="car_silver" route="r_N3_S3" begin="0" end="1000" vehsPerHour="120"/>
    <flow id="flow_hwy_N3_S3_suv" type="car_suv" route="r_N3_S3" begin="0" end="1000" vehsPerHour="90"/>
    <flow id="flow_hwy_N3_S3_van" type="van_white" route="r_N3_S3" begin="0" end="1000" vehsPerHour="30"/>
    <flow id="flow_hwy_S3_N3_blue" type="car_blue" route="r_S3_N3" begin="0" end="1000" vehsPerHour="110"/>
    <flow id="flow_hwy_S3_N3_red" type="car_red" route="r_S3_N3" begin="0" end="1000" vehsPerHour="90"/>

    <!-- Local & Connecting Flows -->
    <flow id="flow_local_W2_E2" type="car_white" route="r_W2_E2" begin="1" end="1000" vehsPerHour="140"/>
    <flow id="flow_local_W2_E2_van" type="van_white" route="r_W2_E2" begin="1" end="1000" vehsPerHour="25"/>
    <flow id="flow_local_E2_W2" type="car_silver" route="r_E2_W2" begin="1" end="1000" vehsPerHour="130"/>
    <flow id="flow_local_E2_W2_van" type="van_white" route="r_E2_W2" begin="1" end="1000" vehsPerHour="25"/>

    <flow id="flow_N1_E1" type="car_red" route="r_N1_E1" begin="2" end="1000" vehsPerHour="110"/>
    <flow id="flow_N1_S1" type="car_suv" route="r_N1_S1" begin="2" end="1000" vehsPerHour="100"/>
    <flow id="flow_N2_S2" type="car_blue" route="r_N2_S2" begin="3" end="1000" vehsPerHour="110"/>
    <flow id="flow_S2_N2" type="car_white" route="r_S2_N2" begin="3" end="1000" vehsPerHour="100"/>
    <flow id="flow_S1_N1" type="motorcycle" route="r_S1_N1" begin="4" end="1000" vehsPerHour="60"/>

    <!-- Turning & Cross Flows -->
    <flow id="flow_W1_S1" type="car_silver" route="r_W1_S1" begin="5" end="1000" vehsPerHour="90"/>
    <flow id="flow_E1_S1" type="car_suv" route="r_E1_S1" begin="5" end="1000" vehsPerHour="80"/>
    <flow id="flow_N2_E2" type="car_red" route="r_N2_E2" begin="6" end="1000" vehsPerHour="70"/>
    <flow id="flow_W2_N2" type="car_blue" route="r_W2_N2" begin="6" end="1000" vehsPerHour="70"/>
    <flow id="flow_S2_N3" type="car_white" route="r_S2_N3" begin="7" end="1000" vehsPerHour="60"/>
    <flow id="flow_N3_W1" type="car_silver" route="r_N3_W1" begin="7" end="1000" vehsPerHour="80"/>
    <flow id="flow_W1_S2" type="motorcycle" route="r_W1_S2" begin="8" end="1000" vehsPerHour="50"/>

    <!-- City Buses & Coaches -->
    <flow id="flow_hwy_W1_E1_bus" type="city_bus" route="r_W1_E1" begin="10" end="1000" vehsPerHour="35"/>
    <flow id="flow_hwy_N3_S3_coach" type="coach_bus" route="r_N3_S3" begin="12" end="1000" vehsPerHour="25"/>
    <flow id="flow_local_W2_E2_bus" type="city_bus" route="r_W2_E2" begin="14" end="1000" vehsPerHour="30"/>

    <!-- Freight & Logistics Trucks -->
    <flow id="flow_hwy_E1_W1_truck" type="delivery_truck" route="r_E1_W1" begin="15" end="1000" vehsPerHour="40"/>
    <flow id="flow_hwy_S3_N3_heavy" type="heavy_truck" route="r_S3_N3" begin="18" end="1000" vehsPerHour="30"/>
    <flow id="flow_hwy_W1_E1_heavy" type="heavy_truck" route="r_W1_E1" begin="20" end="1000" vehsPerHour="25"/>
</routes>
